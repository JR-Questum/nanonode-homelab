# Managed by Ansible - deploy_playlist_aggregator.
[Unit]
Description=Weekly Spotify playlist aggregation

[Timer]
OnCalendar={{ deploy_playlist_aggregator_schedule }}
RandomizedDelaySec={{ deploy_playlist_aggregator_splay }}
# Run on next boot if the machine was off when the timer was due.
Persistent=true
Unit={{ deploy_playlist_aggregator_name }}.service

[Install]
WantedBy=timers.target